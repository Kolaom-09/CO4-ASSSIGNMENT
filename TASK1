from decimal import Decimal, InvalidOperation


def process_mess_bill(filename):
    total = Decimal("0.00")
    report = []
    rejected_lines = []

    try:
        with open(filename, "r", encoding="utf-8") as file:
            for line_number, line in enumerate(file, start=1):
                if not line.strip():
                    continue

                try:
                    parts = line.strip().split(",")

                    if len(parts) != 3:
                        raise ValueError("Invalid number of fields")

                    reg_no, name, amount = parts
                    bill = Decimal(amount.strip())

                    if not bill.is_finite():
                        raise ValueError("Invalid amount")

                    total += bill
                    report.append(f"{name.strip()} {bill:.2f}")

                except (ValueError, InvalidOperation) as error:
                    rejected_lines.append(
                        (line_number, line.strip(), str(error))
                    )

        print("MESS BILL REPORT")
        for item in report:
            print(item)

        print("Total:", total)

        print("\nRejected Lines:")
        for item in rejected_lines:
            print(item)

    except FileNotFoundError:
        print("Error: File not found")

    except PermissionError:
        print("Error: Permission denied")


if __name__ == "__main__":
    process_mess_bill("mess_oct.txt")
