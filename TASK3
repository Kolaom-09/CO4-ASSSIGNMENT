import os


def save_returns(books):
    with open("returns.log", "a", encoding="utf-8") as log:
        for book in books:
            log.write(book + "\n")


def process(day_file):
    try:
        with open(day_file, "r", encoding="utf-8") as file:
            books = file.read().splitlines()

        save_returns(books)

    except FileNotFoundError as error:
        with open("error.log", "a", encoding="utf-8") as log:
            log.write(f"Missing file: {day_file}\n")

    except PermissionError as error:
        with open("error.log", "a", encoding="utf-8") as log:
            log.write(f"Permission denied: {day_file}\n")

    except OSError as error:
        with open("error.log", "a", encoding="utf-8") as log:
            log.write(f"File error: {error}\n")


if __name__ == "__main__":

    day1 = ["Python Programming", "Data Structures"]
    day2 = ["Database Systems", "Computer Networks"]
    day3 = ["Operating Systems", "Software Engineering"]

    with open("day1.txt", "w", encoding="utf-8") as f:
        f.write("\n".join(day1))

    with open("day2.txt", "w", encoding="utf-8") as f:
        f.write("\n".join(day2))

    with open("day3.txt", "w", encoding="utf-8") as f:
        f.write("\n".join(day3))

    process("day1.txt")
    process("day2.txt")
    process("day3.txt")
    process("missing.txt")

    print("RETURNED BOOKS LOG")

    with open("returns.log", "r", encoding="utf-8") as f:
        print(f.read())

    print("ERROR LOG")

    if os.path.exists("error.log"):
        with open("error.log", "r", encoding="utf-8") as f:
            print(f.read())
